{
  "expo": {
    "name": "Ground Station",
    "slug": "ground-station",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "groundstation",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mutaaf.groundstation"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mutaaf.groundstation"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ground Station uses the camera to show the sky behind the star overlay."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ground Station uses your location to work out which stars are above you.",
          "locationWhenInUsePermission": "Ground Station uses your location to work out which stars are above you."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Ground Station uses motion to follow where you point the phone."
        }
      ],
      "expo-asset",
      [
        "./plugins/with-ios-signing",
        {
          "teamId": "95988FTS33"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#08090B"
  }
}
